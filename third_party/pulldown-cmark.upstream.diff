+/// Whether this body yields `Event::Start` in the event stream (and hence has
+/// children to descend into). Must stay in sync with the `Event::Start` arm
+/// set of [`item_to_event`]; the one intentional extra is `TightParagraph`,
+/// which the lazy path handles specially (`next` pushes into it while
+/// emitting nothing).
+///
+/// `tree_matches_event_stream` in `tests/tree_api.rs` is the guard for this
+/// equivalence.
+#[cfg(feature = "tree")]
+fn is_container_body(body: &ItemBody) -> bool {
+    use ItemBody::*;
+    matches!(
+        *body,
+        Paragraph
+            | TightParagraph
+            | Heading(..)
+            | FencedCodeBlock(..)
+            | IndentCodeBlock
+            | HtmlBlock
+            | BlockQuote(..)
+            | List(..)
+            | ListItem(..)
+            | FootnoteDefinition(..)
+            | MetadataBlock(..)
+            | Table(..)
+            | TableHead
+            | TableRow
+            | TableCell
+            | DefinitionList(..)
+            | DefinitionListTitle
+            | DefinitionListDefinition(..)
+            | Emphasis
+            | Strong
+            | Strikethrough
+            | Superscript
+            | Subscript
+            | Link(..)
+            | Image(..)
+    )
+}
+
+#[cfg(feature = "tree")]
+impl<'input, F: BrokenLinkCallback<'input>> Parser<'input, F> {
+    /// Resolve every inline of the whole tree, without producing events.
+    ///
+    /// The cursor advances exactly like the iterator's `next` does (the same
+    /// push / next_sibling / pop sequence), so `handle_inline` sees the same
+    /// tree/spine state as under the lazy path. The differences are
+    /// deliberate: `item_to_event` is never called (so `allocs` is not taken
+    /// from), and `TightParagraph` is a plain container here — a real node
+    /// for tree consumers, invisible in the event stream.
+    fn resolve_all_inlines(&mut self) {
+        loop {
+            match self.tree.cur() {
+                None => {
+                    let Some(ix) = self.tree.pop() else { return };
+                    self.tree.next_sibling(ix);
+                }
+                Some(cur_ix) => {
+                    if self.tree[cur_ix].item.body.is_maybe_inline() {
+                        self.handle_inline();
+                        // `handle_inline` rewrote the node in place at
+                        // `cur_ix`; like the lazy path, re-read by index.
+                    }
+                    if is_container_body(&self.tree[cur_ix].item.body) {
+                        self.tree.push();
+                    } else {
+                        self.tree.next_sibling(cur_ix);
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Parse the whole document with all inlines resolved, returning the tree and
+/// a fully-populated allocation table. Never touches `item_to_event`, so the
+/// result stays repeatable read-only. Used by `tree_api::Parsed`.
+#[cfg(feature = "tree")]
+pub(crate) fn eager_parse<'input, F: BrokenLinkCallback<'input>>(
+    text: &'input str,
+    options: Options,
+    broken_link_callback: Option<F>,
+) -> (Tree<Item>, Allocations<'input>) {
+    let mut parser = Parser::new_with_broken_link_callback(text, options, broken_link_callback);
+    parser.resolve_all_inlines();
+    parser.tree.reset();
+    let Parser { tree, allocs, .. } = parser;
+    (tree, allocs)
+}
