+#[cfg(feature = "tree")]
+impl<'input, F: BrokenLinkCallback<'input>> Parser<'input, F> {
+    /// Resolve every inline of the whole tree, without producing events.
+    ///
+    /// The cursor advances exactly like the iterator's `next` does (the same
+    /// push / next_sibling / pop sequence), so `handle_inline` sees the same
+    /// tree/spine state as under the lazy path. The differences are
+    /// deliberate: `item_to_event` is never called (so `allocs` is not taken
+    /// from), and `TightParagraph` is a plain container here — a real node
+    /// for tree consumers, invisible in the event stream.
+    fn resolve_all_inlines(&mut self) {
+        loop {
+            match self.tree.cur() {
+                None => {
+                    let Some(ix) = self.tree.pop() else { return };
+                    self.tree.next_sibling(ix);
+                }
+                Some(cur_ix) => {
+                    if self.tree[cur_ix].item.body.is_maybe_inline() {
+                        self.handle_inline();
+                        // `handle_inline` rewrote the node in place at
+                        // `cur_ix`; like the lazy path, re-read by index.
+                    }
+                    if is_container_body(&self.tree[cur_ix].item.body) {
+                        self.tree.push();
+                    } else {
+                        self.tree.next_sibling(cur_ix);
+                    }
+                }
+            }
+        }
+    }
+}
